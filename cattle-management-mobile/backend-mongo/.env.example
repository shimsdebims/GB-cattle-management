# ─── API environment ─────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in MONGODB_URI. Nothing else is required.

# Your Atlas connection string: https://cloud.mongodb.com -> Connect -> Drivers
#
# Remember to put a database name before the "?" — without one, Mongoose
# silently uses a database called "test".
#
# Example:
# MONGODB_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/cattle-management?retryWrites=true&w=majority
MONGODB_URI=

# ─── Login ───────────────────────────────────────────────────────────────────
# Keep false until both apps have the login screen, then true.
AUTH_REQUIRED=false
# 32+ random characters, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
AUTH_SECRET=
# Owner account created on first boot when no user exists (ignored afterwards).
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ─── Backups (scripts/backup.js, scripts/restore.js) ────────────────────────
# 16+ characters. Store it in a password manager: backups are useless without it.
BACKUP_PASSPHRASE=
# Target for restore.js only — deliberately separate from MONGODB_URI.
RESTORE_URI=

# Optional. Defaults shown.
PORT=8080
NODE_ENV=development

# NOTE: the test suite does NOT use this file. It spins up an in-memory
# MongoDB, so `npm test` never touches a real cluster.
