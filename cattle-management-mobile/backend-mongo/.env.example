# ─── API environment ─────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in MONGODB_URI. Nothing else is required.

# Your Atlas connection string: https://cloud.mongodb.com -> Connect -> Drivers
#
# Remember to put a database name before the "?" — without one, Mongoose
# silently uses a database called "test".
#
# Example:
# MONGODB_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/cattle-management?retryWrites=true&w=majority
MONGODB_URI=

# Optional. Defaults shown.
PORT=8080
NODE_ENV=development

# NOTE: the test suite does NOT use this file. It spins up an in-memory
# MongoDB, so `npm test` never touches a real cluster.
